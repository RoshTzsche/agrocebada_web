{
  "name": "agrocebada-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:demo": "node scripts/seed_demo.js",
    "importar": "node scripts/importar_csv.js",
    "importar:modelo": "python3 scripts/importar_modelo.py",
    "verificar:importador": "python3 -m unittest discover -s tests -p 'test_importar_modelo.py'",
    "preparar": "node scripts/preparar_deploy.js",
    "demo:preparar": "node scripts/prepare_demo_db.js",
    "demo:completar": "node scripts/prepare_demo_db.js --completar",
    "dev:local": "node --env-file=.env --watch server.js",
    "start:local": "node --env-file=.env server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}

